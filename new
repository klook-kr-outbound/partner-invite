<main>
  <div class="col">
    <section>
      <h2>간편한 입점 진행 절차</h2>
      <ol class="list steps">
        <li><div><b>파트너 가입하기 버튼 클릭 및 계정 신청</b><span>머천트 포털에서 기본 업체 정보를 입력하고 계정을 생성합니다.</span></div></li>
        <li><div><b>상품 세팅 무료 지원</b><span>계정 가입 완료 후 상품 정보만 전달해 주세요. 상품 페이지 제작 및 등록을 클룩에서 직접 지원하여 등록 부담을 덜어드립니다.</span></div></li>
      </ol>
    </section>

    <section>
      <h2>클룩 파트너만의 핵심 혜택</h2>
      <ul class="list">
        <li><b>한국인 타깃 마케팅 최적화</b><span>검색 최적화(SEO), 인플루언서 네트워크, 브랜드 기획전을 연계하여 한국인 여행객에게 귀사의 상품을 가장 효과적으로 노출합니다.</span></li>
        <li><b>편리한 글로벌 결제 환경</b><span>카카오페이·네이버페이 등 국내 간편결제는 물론, 40여 개 이상의 다국적 결제 수단을 제공하여 예약 전환율을 높입니다.</span></li>
        <li><b>글로벌 인지도 및 확장성</b><span>월간 활성 사용자(MAU) 7,000만 명의 글로벌 플랫폼을 발판 삼아, 향후 외국인 여행객으로 고객층을 손쉽게 확장할 수 있습니다.</span></li>
      </ul>
    </section>

    <section>
      <h2>주요 프로모션 지원 사례 <span class="badge">2026.10.27 기준</span></h2>
      <ul class="list">
        <li><b>리뷰 이벤트 지원</b><span>건당 3,000원 상당의 리뷰 작성 혜택을 지원하여 초기 모객 및 구매 신뢰도 확보</span></li>
        <li><b>유럽 지역 프로모션</b><span>유럽 투어·액티비티 대상 10~20% 할인 쿠폰 발행 및 기획전 노출 지원</span></li>
      </ul>
      <p class="note">※ 안내 사항<br>상기 내용은 2026년 파트너사 지원 사례이며, 프로모션의 세부 진행 여부 및 지원 조건은 시즌 및 내부 운영 정책에 따라 변경될 수 있습니다.</p>
    </section>

    <section>
      <h2>가입하셨나요?</h2>
      <form id="f">
        <label for="em">가입 이메일 주소</label>
        <input id="em" type="email" inputmode="email" autocomplete="email" placeholder="name@company.com" required>
        <label for="ln">등록 희망 상품 링크 (선택)</label>
        <textarea id="ln" rows="4" inputmode="url" placeholder="https://"></textarea>
        <p class="hint">자사 몰이나 타 플랫폼에서 판매 중인 상품 URL을 복사해 붙여넣어 주세요. (URL이 여러 개일 경우 줄바꿈으로 구분)</p>
        <button class="btn" type="submit">보내기</button>
        <p class="msg" id="msg" role="status"></p>
      </form>
    </section>

    <p class="foot">문의: 클룩 사업개발팀 · <a href="mailto:kr_ob_bd_contact@klook.com">kr_ob_bd_contact@klook.com</a></p>
  </div>
</main>

<script>
/* ============ 설정 ============ */
var CONFIG = {
  PORTAL_URL: "https://merchant.klook.com/ko/signup?classification=tours",
  // Apps Script 웹 앱 배포 URL을 넣으면 로그가 구글 시트에 쌓입니다. 비워 두면 기록만 생략되고 페이지는 정상 동작합니다.
  LOG_ENDPOINT: "https://script.google.com/macros/s/AKfycbxEgaqb6Zd69676mIxL0AXCp18pW_Wdh4Vw3N42AkyoB2i5B5EJ3N8ME8v5v-FbcTDW/exec",
  UTM: { utm_source: "bd_email", utm_medium: "email", utm_campaign: "es_kr_tours" },
  MIN_HUMAN_MS: 1500   // 페이지 열림 후 이 시간보다 빨리 눌리면 '의심 클릭'
};

/* ============ 파라미터 (?ref=ES_001&n=업체명) ============ */
var qs = new URLSearchParams(location.search);
var REF = (qs.get("ref") || "").slice(0, 60);
var NAME = (qs.get("n") || "").slice(0, 40);
if (NAME) document.getElementById("who").textContent = NAME + " 대표님";

/* 포털 링크: UTM + ref 부착 (포털이 무시해도 가입 페이지는 정상 열림) */
var portal = new URL(CONFIG.PORTAL_URL);
Object.keys(CONFIG.UTM).forEach(function (k) { portal.searchParams.set(k, CONFIG.UTM[k]); });
if (REF) portal.searchParams.set("utm_content", REF);
document.getElementById("go").href = portal.toString();

/* ============ 로그 ============ */
var T0 = performance.now();
var lastPointer = "";
function ms() { return Math.round(performance.now() - T0); }
function log(event, extra) {
  var p = Object.assign({
    ref: REF, event: event, ms: ms(), pointer: lastPointer,
    ua: navigator.userAgent, lang: navigator.language, vis: document.visibilityState
  }, extra || {});
  if (!CONFIG.LOG_ENDPOINT) return;
  try {
    var body = JSON.stringify(p);
    if (!(navigator.sendBeacon && navigator.sendBeacon(CONFIG.LOG_ENDPOINT, new Blob([body], { type: "text/plain" })))) {
      fetch(CONFIG.LOG_ENDPOINT, { method: "POST", mode: "no-cors", keepalive: true, body: body });
    }
  } catch (e) { /* 기록 실패는 사용자 흐름에 영향 주지 않음 */ }
}

log("page_view");

/* 실제 사용자 조작(스크롤/터치 등)이 처음 발생하면 1회 기록 → 봇의 단순 열람과 구분 */
var engaged = false;
["touchstart", "pointerdown", "scroll", "keydown", "mousemove"].forEach(function (t) {
  window.addEventListener(t, function (e) {
    if (e.type === "pointerdown") lastPointer = e.pointerType || "";
    if (engaged || !e.isTrusted) return;
    engaged = true; log("engaged");
  }, { passive: true });
});

/* 포털 버튼: 이동을 막지 않고 기록만 전송 */
document.getElementById("go").addEventListener("click", function (e) {
  var human = e.isTrusted && ms() >= CONFIG.MIN_HUMAN_MS;
  log("portal_click", { label: human ? "human" : "suspect", trusted: e.isTrusted });
});

document.getElementById("later").addEventListener("click", function (e) {
  log("interest_later", { trusted: e.isTrusted });
  this.textContent = "알겠습니다. 편하실 때 다시 열어 주세요.";
  this.disabled = true;
});

document.getElementById("f").addEventListener("submit", function (e) {
  e.preventDefault();
  var v = document.getElementById("em").value.trim();
  if (!v) return;
  log("email_submit", { email: v, links: document.getElementById("ln").value.trim().slice(0, 1500), trusted: e.isTrusted });
  document.getElementById("msg").textContent = "감사합니다. 확인 후 등록 안내를 드리겠습니다.";
  document.querySelector("#f .btn").disabled = true;
});
</script>
</body>
