<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>스페인 파트너 초대</title>
<style>
/* Layout: 세로형 환영 카드(빨강 히어로, 스페인 랜드마크 콜라주) + 아래로 스크롤되는 혜택/프로모션/이메일 섹션 */
:root{
  --red:#C8102E; --red-deep:#8E0B20; --gold:#FFC400; --ink:#4A0510;
  --bg:#FBF5F5; --fg:#3A0D14; --muted:#7A5A5F; --card:#FFFFFF; --line:#EBD6D8;
  --font:"Pretendard","Apple SD Gothic Neo","Noto Sans KR","Malgun Gothic",system-ui,sans-serif;
}
@media (prefers-color-scheme: dark){
  :root{ --bg:#1C0D10; --fg:#FBEDEE; --muted:#D2A9AE; --card:#2A1418; --line:#4A2429; color-scheme:dark; }
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--fg);font-family:var(--font);font-size:16px;line-height:1.6;-webkit-text-size-adjust:100%}

.hero{
  background:linear-gradient(180deg,#C8102E 0%,#A30D26 100%);
  color:#fff; min-height:100svh;
  padding-block:max(24px,env(safe-area-inset-top)) 28px;
  padding-left:max(20px,env(safe-area-inset-left)); padding-right:max(20px,env(safe-area-inset-right));
}
.hero-in{max-width:440px;margin:0 auto;min-height:calc(100svh - 52px);display:flex;flex-direction:column;gap:16px}
.eyebrow{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#FFE27A;font-weight:700;margin:0}
.hello{font-size:17px;margin:0;opacity:.95}
h1{font-size:clamp(28px,8vw,36px);line-height:1.25;margin:0;font-weight:800;text-wrap:balance;letter-spacing:-.02em}
.art{flex:1;min-height:200px;display:flex;align-items:center;justify-content:center}
.art svg{width:100%;max-width:300px;height:auto;display:block;filter:drop-shadow(0 8px 0 rgba(70,0,10,.35))}
.cta{
  display:flex;align-items:center;justify-content:center;gap:8px;
  background:var(--gold);color:var(--ink);text-decoration:none;font-weight:800;font-size:18px;
  padding:17px 20px;border-radius:14px;box-shadow:0 6px 0 rgba(70,0,10,.45);
}
.cta:active{transform:translateY(3px);box-shadow:0 3px 0 rgba(70,0,10,.45)}
.cta:focus-visible,.later:focus-visible{outline:3px solid #fff;outline-offset:3px}
.btn:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid var(--red);outline-offset:2px}
.sub{font-size:13px;text-align:center;margin:0;opacity:.9}
.later{background:none;border:0;color:#fff;opacity:.9;font:inherit;font-size:14px;text-decoration:underline;padding:8px;cursor:pointer;align-self:center}

main{
  padding-block:36px max(40px,env(safe-area-inset-bottom));
  padding-left:max(20px,env(safe-area-inset-left)); padding-right:max(20px,env(safe-area-inset-right));
}
.col{max-width:440px;margin:0 auto;display:flex;flex-direction:column;gap:28px}
h2{font-size:20px;margin:0 0 12px;letter-spacing:-.01em;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.badge{font-size:12px;font-weight:700;background:var(--gold);color:var(--ink);padding:2px 9px;border-radius:999px;letter-spacing:0}
.list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px}
.list li{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 16px;min-width:0}
.list b{display:block;margin-bottom:2px}
.list span{color:var(--muted);font-size:14px}
.list small{display:block;color:var(--muted);font-size:12px;margin-top:4px}
.steps{counter-reset:s}
.steps li{display:flex;gap:12px;align-items:flex-start}
.steps li::before{counter-increment:s;content:counter(s,decimal-leading-zero);flex:none;width:30px;height:30px;border-radius:50%;background:var(--red);color:#fff;font-weight:700;font-size:13px;display:grid;place-items:center;margin-top:0}
.note{font-size:11.5px;line-height:1.55;color:var(--muted);margin:12px 0 0}
.hint{font-size:12px;line-height:1.5;color:var(--muted);margin:-4px 0 0}
form{display:flex;flex-direction:column;gap:10px}
label{font-size:14px;color:var(--muted)}
input[type=email],textarea{font:inherit;padding:14px;border-radius:10px;border:1px solid var(--line);background:var(--card);color:var(--fg);width:100%}
textarea{resize:vertical;min-height:96px;line-height:1.5}
.btn{font:inherit;font-weight:700;padding:14px;border-radius:10px;border:0;background:var(--red);color:#fff;cursor:pointer}
.msg{font-size:14px;color:var(--muted);margin:0;min-height:1.4em}
.foot{font-size:12px;color:var(--muted);margin:0}
.foot a{color:inherit}
@media (prefers-reduced-motion: no-preference){ .cta{transition:transform .08s,box-shadow .08s} }
</style>
</head>
